<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PAB.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PresentationMode" 
        WindowState="Maximized" 
        WindowStyle="None"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        Closing="Window_Closing">
    <Grid x:Name="PresentationGrid" Background="Black">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="ContentPanel">
            <StackPanel x:Name="MusicPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="MusicTitle" 
                           Text="" 
                           FontSize="60" 
                           Foreground="White" 
                           TextAlignment="Center" 
                           FontWeight="Bold"
                           Margin="30"
                           TextWrapping="Wrap"
                           MaxWidth="1200"/>
            </StackPanel>

            <StackPanel x:Name="BiblePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="BibleTitle" 
                           Text="" 
                           FontSize="32" 
                           Foreground="White" 
                           TextAlignment="Center" 
                           FontWeight="Bold"
                           Margin="30,30,30,15"
                           MaxWidth="900"/>
                <TextBlock x:Name="BibleContent" 
                           Text="" 
                           FontSize="28" 
                           Foreground="White" 
                           TextAlignment="Center" 
                           Margin="30,15,30,30"
                           TextWrapping="Wrap"
                           MaxWidth="900"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="NavigationInfo" 
                   Text="Use arrow keys or mouse to navigate | Press ESC to exit" 
                   Foreground="Gray" 
                   FontSize="12" 
                   VerticalAlignment="Bottom" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>
        
        <TextBlock x:Name="SlideCounter" 
                   Text="1/1" 
                   Foreground="Gray" 
                   FontSize="14" 
                   VerticalAlignment="Bottom" 
                   HorizontalAlignment="Right" 
                   Margin="0,0,20,10"/>
    </Grid>
</Window>
